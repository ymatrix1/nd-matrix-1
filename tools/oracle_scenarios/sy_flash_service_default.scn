msg 0x92432 0xbf800000
irq 17 400000
poke 0x95000 1
poke 0x95001 0
poke 0xB6510 1
poke 0xB6511 0x95000
poke 0xB6512 0x95100
poke 0x95100 0
poke 0x95101 16
# image default: DM(0xB650F) = 0x93FF7 (no poke)
set R0 0
run 0x1c09a9 400000
