# Checksum flash service (0x1C09A9) as the ARM can drive it: DM(0xB650F) is left at its image default (D195, docs/research/sy-flash-service-hunt.md):
#   python -c "open('target/oracle/np/ext.bin','wb').write(bytes([0xA5])*0x400000)"
#   sharc-ref target/oracle/sy.bin tools/oracle_scenarios/sy_flash_service_default.scn --out target/oracle/np/crcdef --watch 0xB650F:1 --watch 0x93500:0xA0
# Result: epchain window_hits=0, third TCB ext 0xC000000 -> DM 0x93FF7 (the staging buffer), count 4. The ext image is a synthetic fill.
# SY1SY2 command FIFO opcode handlers 1 to 15 (`DM(0x92182 + opcode)`) run one by one with a window
epchain path=target/oracle/np/ext.bin base=0x0
# address in R6 and a value in R7, as the audio ISR dispatch would (D111). The dispatch at 0x1C064B is a
# conditional CALL in the last instruction of the loop `0x1C0635..0x1C064B`, which the oracle core does
# not enter (the handlers are never reached through `msg op=N`), so `run` calls each body directly.
#   sharc-ref sy.bin tools/oracle_scenarios/sy_isr_handlers.scn --watch 0x93500:0xA0
# Result: no write into DM 0x93500..0x935A0 from any handler.
meta rate 48000
warmup 0x1c0b2d 100000 flag12=1
poke 0x93E0C 0xFFFFFFFF
poke 0x93E0D 0xFFFFFFFF
poke 0x93E12 0xFFFFFFFF
poke 0x93E13 0xFFFFFFFF
poke 0x93E18 0xFFFFFFFF
poke 0x93E19 0xFFFFFFFF
poke 0x93E1E 0xFFFFFFFF
poke 0x93E1F 0xFFFFFFFF
poke 0x93E20 0x1
poke 0x95C69 0x92426
poke 0x95C6A 0x0
poke 0x95C6B 0x92426
poke 0x95C7B 0x95C6D
poke 0x95C7C 0x1C12DD
poke 0x95C7D 0x1C12DD
poke 0x95C7E 0x1C12DD
poke 0x95C7F 0x1C12DD
poke 0x95C80 0x1C14BD
poke 0x95C81 0x1C14B6
poke 0x95C82 0x1C15CB
poke 0x95C83 0x1C15C4
poke 0x95C84 0x1C16DC
poke 0x95C85 0x1C16D5
poke 0x95C86 0x1C17EC
poke 0x95C87 0x1C17E5
poke 0x95C88 0x1C1901
poke 0x95C89 0x1C18FA
poke 0x95C8A 0x1C1A17
poke 0x95C8B 0x1C1A10
poke 0x95C8C 0x1C1B30
poke 0x95C8D 0x1C1B29
poke 0x95C8E 0x1C1C44
poke 0x95C8F 0x1C1C3D
poke 0x95C90 0x1C1D61
poke 0x95C91 0x1C1D5A
poke 0x95C92 0x1C1E7F
poke 0x95C93 0x1C1E78
poke 0x95C94 0x1C1FA0
poke 0x95C95 0x1C1F99
poke 0x95C96 0x1C20C0
poke 0x95C97 0x1C20B9
poke 0x95C98 0x1C21E5
poke 0x95C99 0x1C21DE
poke 0x95C9A 0x1C12E7
poke 0x95C9B 0x1C12E0
poke 0x95C9C 0x1C12DD
poke 0x95C9D 0x1C12DD
poke 0x95CBC 0xA5A5A5A5
poke 0x95CBD 0xB4B4B4B4
poke 0x95CBE 0xC3C3C3C3
poke 0x95CBF 0xD2D2D2D2
poke 0x95CC0 0xE1E1E1E1
poke 0x95CC1 0xF0F0F0F0
irq 13
msg 0x92414 0x1c0794
msg 0xc1dcc 0x4000100
msg 0x92414 0x1c0794
msg 0x92416 0
msg 0x92420 0x3f128f5c
msg 0x92421 0xbedae148
msg 0x9240a 0xc
msg 0x9240b 0x2c60
msg 0x92413 7
msg 0x9240c 0xd
msg 0x9240d 0xb40
msg 0x9240e 0xd
msg 0x9240f 0xbe0
msg 0x92414 0x1c07cd
msg 0x92433 0
msg 0x9243b 0xe4c00
